
{
  "cli": {
    "version": ">= 25.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://server-titanium.onrender.com"
      },
      "android": {
        "buildType": "apk",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/release/**"
        ]
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "buildArtifactPaths": [
          "android/app/build/outputs/mapping/release/**"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
