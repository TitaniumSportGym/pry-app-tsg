{
  "name": "pry-app-tsg",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "expo": "^58.0.0",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "reassure": "^1.6.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=/node_modules/ --testPathIgnorePatterns=/tests/integration/",
    "test:integration": "jest tests/integration",
    "test:acceptance": "jest --config tests/acceptance/jest.config.cjs",
    "test:perf": "reassure"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/repository-cache.ts"
    ],
    "testTimeout": 30000
  },
  "private": true
}
